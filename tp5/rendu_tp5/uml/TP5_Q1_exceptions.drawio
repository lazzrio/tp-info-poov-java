ception" value="" style="endArrow=block;endFill=0;endSize=14;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=none;" edge="1" parent="1" source="CommandeVideException" target="FastBiteException"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="EtatLivraisonException" value="&lt;b&gt;EtatLivraisonException&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1470" y="398" width="255" height="30" as="geometry" /></mxCell><mxCell id="g_EtatLivraisonException" value="" style="endArrow=block;endFill=0;endSize=14;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=none;" edge="1" parent="1" source="EtatLivraisonException" target="FastBiteException"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="FormatFichierException" value="&lt;b&gt;FormatFichierException&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1470" y="442" width="255" height="30" as="geometry" /></mxCell><mxCell id="g_FormatFichierException" value="" style="endArrow=block;endFill=0;endSize=14;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=none;" edge="1" parent="1" source="FormatFichierException" target="FastBiteException"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="g_fb" value="" style="endArrow=block;endFill=0;endSize=14;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="FastBiteException" target="Exception"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_q1" value="&lt;b&gt;Notation&lt;/b&gt; : « throws X » = la méthode peut lever X (UML : {exceptions = X}).&lt;br&gt;Toutes les FastBiteException sont &lt;b&gt;vérifiées&lt;/b&gt; (try/catch ou throws obligatoire).&lt;br&gt;&lt;b&gt;Non vérifiée&lt;/b&gt; : IllegalArgumentException (plat null) – bug du code, inchangé depuis le TP4.&lt;br&gt;&lt;b&gt;Nouveau TP5&lt;/b&gt; : Evaluable déclare les throws ; Livreur, Plat, Restaurant doivent les respecter ;&lt;br&gt;Panier redéfinit ajouterPlat avec le même throws que Commande." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1470" y="522" width="520" height="125" as="geometry" /></mxCell></root>
